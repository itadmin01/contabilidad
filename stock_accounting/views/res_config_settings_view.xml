<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_stock_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.stock.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='schedule_info']" position="after">
                <block title="Contabilidad de inventario" id="stock_accounting_div">
                    <setting string="Automatización de contabilidad" tittle="Habilita la valuación automática de inventario" name="stock_accounting_setting_container">
                        <field name="group_stock_accounting_automatic"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
