#. module: om_fiscal_year
#: model:ir.model.fields,help:om_fiscal_year.field_change_lock_date__tax_lock_date
msgid ""
"No users can edit journal entries related to a tax prior and inclusive of "
"this date."
msgstr ""
"Ningún usuario puede editar asientos relacionados con un impuesto anterior "
"e inclusive a esta fecha."

#. module: om_fiscal_year
#: model:ir.model.fields,help:om_fiscal_year.field_res_config_settings__fiscalyear_lock_date
msgid ""
"No users, including Advisers, can edit accounts prior to and inclusive of "
"this date. Use it for fiscal year locking for example."
msgstr ""
"Ningún usuario, incluidos los Asesores, puede editar cuentas anteriores a "
"esta fecha e inclusive. Utilícelo, por ejemplo, para el cierre del "
"ejercicio."

#. module: om_fiscal_year
#: model:ir.model.fields,help:om_fiscal_year.field_change_lock_date__fiscalyear_lock_date
msgid ""
"No users, including Advisers, can edit accounts prior to and inclusive of "
"this date. Use it for fiscal year locking."
msgstr ""
"Ningún usuario, incluidos los Asesores, puede editar cuentas anteriores a "
"esta fecha e inclusive. Utilícelo para el bloqueo del año fiscal."

#. module: om_fiscal_year
#: model:ir.model.fields,help:om_fiscal_year.field_res_config_settings__period_lock_date
msgid ""
"Only users with the 'Adviser' role can edit accounts prior to and inclusive "
"of this date. Use it for period locking inside an open fiscal year, for "
"example."
msgstr ""
"Sólo los usuarios con el rol de 'Asesor' pueden editar cuentas anteriores a "
"esta fecha e inclusive. Utilícelo para bloquear periodos dentro de un "
"ejercicio fiscal abierto, por ejemplo."

#. module: om_fiscal_year
#: model:ir.model.fields,help:om_fiscal_year.field_change_lock_date__period_lock_date
msgid "Prevent posting of journal entries in this period."
msgstr "Evitar la contabilización de asientos en este período."

